# Copy to ".env" and adjust. Everything has a default, so this is optional.

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Memory ---
CONVERSATION_TTL=3600      # forget idle conversations after 1 hour
CONVERSATION_WINDOW=20     # keep the last 20 turns

# --- Model ---
LLM_MODEL=llama-3.3-70b-versatile

# --- Groq (OPTIONAL) ---
# Leave EMPTY to run fully offline with mock agents (recommended for learning).
# Set a real key to make agents call Groq.
GROQ_API_KEY=""

