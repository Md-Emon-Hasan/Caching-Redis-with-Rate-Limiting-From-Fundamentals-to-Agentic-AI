# ============================================================================
#  .env.example - copy this to ".env" and adjust as needed
# ============================================================================
#  The app reads these via config.py. Everything has a sensible default,
#  so you can run the project WITHOUT setting any of these.
# ============================================================================

# --- Redis connection ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Cache TTLs (seconds) ---
LLM_CACHE_TTL=3600          # cache LLM answers for 1 hour
RETRIEVAL_CACHE_TTL=300     # cache retrievals for 5 minutes

# --- Models ---
LLM_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=3                     # how many documents to retrieve per query

# --- Groq (OPTIONAL) ---
# Leave EMPTY to run the LLM with a mock answer.
# Set a real key to use Groq for chat completions.
GROQ_API_KEY=""